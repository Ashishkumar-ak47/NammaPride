<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Back Button -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:backgroundTint="#8D6E63"
            android:textColor="#FFFFFF"/>

        <!-- Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify Authentic Toy"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#5D4037"
            android:layout_marginTop="24dp"/>

        <!-- Subtitle -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the Toy ID to verify authenticity"
            android:textSize="16sp"
            android:textColor="#795548"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"/>

        <!-- Toy Image -->

        <ImageView
            android:id="@+id/toyImage"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/logo"
            android:layout_marginBottom="24dp"/>

        <!-- Input -->

        <EditText
            android:id="@+id/editTextId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Toy ID"
            android:padding="14dp"
            android:textSize="16sp"
            android:backgroundTint="#8D6E63"/>

        <!-- Verify Button -->

        <Button
            android:id="@+id/btnVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify Toy"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:backgroundTint="#5D4037"
            android:textColor="#FFFFFF"/>

        <!-- Result -->

        <TextView
            android:id="@+id/textResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:gravity="center"
            android:layout_marginTop="28dp"/>

    </LinearLayout>

</ScrollView>